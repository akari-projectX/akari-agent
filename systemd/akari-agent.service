# akari node agent (see akari-panel docs/DEPLOY.md, "Add a node").
#
# The canonical copy of this file (and of the updater units) lives in the
# akari-agent repository (systemd/) and is compiled into every release:
# `akari-agent -print-unit akari-agent.service` prints exactly the unit that
# release was built and tested with. The panel's one-line installer installs
# the units of the release it installs (plus a drop-in:
# LoadCredential=tls:/etc/akari-agent/tls for TLS inbounds), and every
# self-update installs the new release's units with its binary (W23): do
# not edit the installed files, put local changes in a drop-in
# (/etc/systemd/system/akari-agent.service.d/*.conf). By hand:
#
#   install -m 0755 agent /usr/local/bin/akari-agent
#   install -d -m 0700 /etc/akari-agent
#   install -m 0600 <node>-bootstrap.toml /etc/akari-agent/bootstrap.toml
#   for u in akari-agent.service akari-agent-update.service akari-agent-update.path; do
#     akari-agent -print-unit $u >/etc/systemd/system/$u; done
#   systemctl daemon-reload && systemctl enable --now akari-agent akari-agent-update.path
#
# The bootstrap file holds a one-time enrollment token (v1 files: the
# node's private key): it stays root-only (0600) and is handed to the
# service as a credential (needs systemd >= 250), so the service runs as a
# throw-away user and cannot read /etc. The agent generates its own key and
# keeps key + certificates in its StateDirectory (/var/lib/private/
# akari-agent, 0700, files 0600; $STATE_DIRECTORY): back it up or the node
# must re-enroll with a new token (`akari server enroll-token`).
#
# Self-update (M6, docs/DEPLOY.md "Agent updates"): the agent never runs
# anything from its StateDirectory (systemd mounts it noexec for
# DynamicUser services, and that is intended). It stages a verified
# download there and asks the privileged updater (akari-agent-update.path
# + akari-agent-update.service, installed by the same installer), which
# re-verifies it, replaces /usr/local/bin/akari-agent (keeping
# akari-agent.prev) and these units (from the new release), restarts this
# service and rolls back both if the new binary does not pass its
# self-check. Nodes installed before W18 lack the updater units, and nodes
# whose updater unit predates W23 cannot refresh units: run the panel's
# install command (重装命令) once (the panel says when).
[Unit]
Description=Akari node agent (xray-core)
Documentation=https://github.com/akari-projectX/akari-agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
LoadCredential=bootstrap.toml:/etc/akari-agent/bootstrap.toml
StateDirectory=akari-agent
StateDirectoryMode=0700
ExecStart=/usr/local/bin/akari-agent -config %d/bootstrap.toml
Restart=always
RestartSec=3
TimeoutStopSec=20
LimitNOFILE=1048576

# --- hardening ------------------------------------------------------------
# Inbounds below port 1024 (443!) need CAP_NET_BIND_SERVICE; nothing else.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# Other users' processes stay hidden. No ProcSubset=pid: it also hides
# /proc/stat, /proc/meminfo, /proc/loadavg and /proc/net/*, the machine
# metrics the agent reports (W11; W23 found them all reading 0).
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077

[Install]
WantedBy=multi-user.target
